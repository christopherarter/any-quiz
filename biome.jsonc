{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // "!app/dist" and "!bin" (no trailing "/**") are Biome's own useBiomeIgnoreFolder fix:
  // since 2.2.0, a trailing "/**" on a folder-exclude pattern is the pre-2.2.0 idiom and no
  // longer needed. Both are committed build output (Vite, esbuild) -- never hand-edited.
  // "!.claude" excludes Claude Code harness files that are managed externally.
  // "!.understand-anything" excludes generated knowledge-graph artifacts -- never hand-edited.
  "files": { "includes": ["**", "!app/dist", "!bin", "!.claude", "!.understand-anything"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "correctness": {
        // Off: this rule is Qwik-specific (serializable-closure check) and this project has
        // no Qwik dependency; it false-positives on ordinary arrow functions/closures.
        "useQwikValidLexicalScope": "off",
        // Off for the same reason, one framework over: Solid props are getters, so
        // destructuring them drops reactivity. React props are a plain object and
        // destructuring in the parameter list is the idiom. No Solid dependency here.
        "noSolidDestructuredProps": "off"
      },
      "performance": {
        // Off: Solid again. `<For>` exists because Solid re-runs `.map()` on every signal
        // read; React re-renders the component instead and `.map()` is the idiom. No Solid
        // dependency here, and there is no `<For>` to import.
        "useSolidForComponent": "off"
      },
      "suspicious": {
        // Bumped to error: under preset "all" this rule defaults to "warn", which exits 0
        // and would let `any` slip through `npm run lint` silently. Error makes it a real gate.
        "noExplicitAny": "error",
        // Off: this rule wants `class` over `className`, which is right for every framework
        // that renders to real HTML attributes and wrong for React, where `class` is not a
        // recognized prop and would be dropped. React is the only renderer in this project.
        "noReactSpecificProps": "off"
      },
      "nursery": { "preset": "recommended" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "overrides": [
    {
      "includes": ["vite.config.ts", "vitest.config.ts"],
      "linter": {
        "rules": {
          "style": {
            // Off here only: Vite/Vitest require the config to be the module's default
            // export; there is no named-export form their loaders will pick up.
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["lib/**", "test/**", "tools/**", "serve.ts"],
      "linter": {
        "rules": {
          "correctness": {
            // Off here only: these paths run under Node (server-side quiz loading/validation
            // in lib/, the test runner, build tooling, dev server), not in the browser bundle
            // this rule exists to protect. No client code imports from lib/; browser code
            // lives under app/.
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["app/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            // Off here only: the rule exists so Fast Refresh can swap a module without
            // losing state, which needs every export to be a component. Test files are
            // never hot-reloaded, and their local render harnesses are test fixtures --
            // exporting them purely to satisfy the rule would be misleading.
            "useComponentExportOnlyModules": "off"
          },
          "performance": {
            // Off here only: the rule hoists regex literals out of hot paths so they are
            // compiled once. Query matchers like `findByText(/1\/2 answered/)` run once per
            // test and read as part of the assertion; naming 30 of them at module scope
            // would move the interesting half of each test away from the test.
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            // Off here only: the rule's heuristic recognizes test(name, fn) but not
            // test.skipIf(cond)(name, fn), so every assertion inside a conditionally
            // skipped vitest test reads as "misplaced". Those callbacks are real test
            // bodies; the rule cannot tell the difference and only fires in test files.
            "noMisplacedAssertion": "off"
          }
        }
      }
    }
  ]
}
